[Unit]
Description=Neo4j MCP Memory Server (mcp-neo4j-memory)
After=network-online.target neo4j.service
Wants=network-online.target

[Service]
Type=simple

# EDIT these three before installing - see contrib/README.md.
User=CHANGEME
WorkingDirectory=/path/to/mcp-neo4j/servers/mcp-neo4j-memory
ExecStart=/path/to/mcp-neo4j/servers/mcp-neo4j-memory/run.sh

# run.sh sources .env itself; nothing else to configure here.
Restart=on-failure
RestartSec=5s

# Belt-and-suspenders hardening; loosen if it gets in the way on your distro.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
