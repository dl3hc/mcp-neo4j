# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# --- Neo4j connection ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# --- MCP transport ---
# "http" for a long-running service other machines/tunnels reach over the network;
# "stdio" only if something launches this process itself and talks to it over its stdin/stdout.
NEO4J_TRANSPORT=http
NEO4J_MCP_SERVER_HOST=127.0.0.1
NEO4J_MCP_SERVER_PORT=8000
NEO4J_MCP_SERVER_PATH=/mcp/
NEO4J_MCP_SERVER_ALLOWED_HOSTS=localhost,127.0.0.1
NEO4J_MCP_SERVER_ALLOW_ORIGINS=http://localhost:8000

# --- Optional ---
# Tool namespace prefix (leave unset unless you're running more than one memory server
# behind the same client and need to tell their tools apart).
# NEO4J_NAMESPACE=

# Rollout flag added by the entity-locking-traversal fork: while unset/false, a write
# blocked by an active lock or a version mismatch is only logged, never rejected. Flip to
# true once lock behavior has been observed in real use across projects.
# NEO4J_MEMORY_ENFORCE_LOCKS=false
